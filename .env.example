# ===== DataRobort 部署环境变量 =====
# 用法：cp .env.example .env，至少填写 OPENAI_API_KEY，然后 docker compose up -d --build

# ---- 必填 ----
# OpenAI 兼容 API Key（Qwen/DeepSeek/vLLM 网关均可）
OPENAI_API_KEY=

# ---- 可选（有默认值）----
# 模型端点与型号
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_CHAT_MODEL=qwen3.7-plus
OPENAI_EMBEDDING_MODEL=qwen3.7-text-embedding

# 平台库（内部网络，无需修改）
PLATFORM_DB_HOST=mysql
PLATFORM_DB_PORT=3306
PLATFORM_DB_NAME=datarobort
PLATFORM_DB_USER=root
# 对外暴露端口（宿主）
# 若与本地开发容器冲突可修改
# MYSQL_PORT=3307
# 生产环境务必修改 root 密码（同时保持 PLATFORM_DB_PASSWORD 一致）
MYSQL_ROOT_PASSWORD=root123

# Redis 8（向量检索用）
SPIKE_REDIS_HOST=redis
SPIKE_REDIS_PORT=6379

# Python 沙箱（必须先在宿主构建镜像）
SANDBOX_IMAGE=datarobort-sandbox:latest
SANDBOX_MAX_CONCURRENCY=2

# 平台密钥（生产环境务必替换）
DATAROBORT_CRYPTO_KEY=datarobort-dev-key-2026

# MCP Server（Claude Desktop 接入）
MCP_SERVER_ENABLED=true

# CORS 白名单（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
